# WhatsApp dos grupos do ateliê (#383) — copie para ~/.urace/whatsapp-grupos.env (chmod 600).
# Valores FICTÍCIOS aqui: o número e os JIDs de verdade só existem no arquivo da VPS, nunca no repositório.
#
#   cp adminai/deploy/whatsapp_grupos/whatsapp-grupos.env.example ~/.urace/whatsapp-grupos.env
#   chmod 600 ~/.urace/whatsapp-grupos.env && nano ~/.urace/whatsapp-grupos.env
#
# Depois: bash adminai/deploy/whatsapp_grupos/configurar_whatsapp_grupos.sh (o deploy também chama).

# 0 = simulação: o script só mostra o que faria e NADA sai para os grupos (os rascunhos ficam no pedido).
# 1 = aplica a config no OpenClaw e libera o envio pela CLI (aprovado no pedido, ou automático se a chave
#     "envio automático" da ponte de Suits estiver ligada).
WA_GRUPOS_APLICAR=0

# O número interno da URACE logado no OpenClaw (login por QR, feito pelo dono). Fictício aqui.
WA_GRUPOS_NUMERO=+14075550123
# A conta do canal WhatsApp no OpenClaw (vazio = a padrão).
WA_GRUPOS_CONTA=

# O segredo entre o plugin urace-atelie e o Command Center. Deixe vazio: o script cria e nunca mostra.
WA_GRUPOS_TOKEN=

# A lista de grupos (configurável: um papel por grupo). design e fornecedor são os que o agente opera;
# um papel novo só registra as mensagens no painel até alguém ensinar o agente a operar nele.
WA_GRUPOS=design,fornecedor

WA_GRUPO_DESIGN_NOME=Macacão design Urace
# O JID (…@g.us) o script acha pelo nome; à mão só se houver dois grupos com o mesmo nome.
WA_GRUPO_DESIGN_JID=
WA_GRUPO_DESIGN_IDIOMA=pt

WA_GRUPO_FORNECEDOR_NOME=Urace Suits - Usman
WA_GRUPO_FORNECEDOR_JID=
WA_GRUPO_FORNECEDOR_IDIOMA=en

# Onde o plugin entrega (o Command Center na própria VPS).
WA_GRUPOS_CC_URL=http://127.0.0.1:8790/ops/api/atelie/whatsapp/entrada
